# ---------- Banco de dados ----------
POSTGRES_USER=ideas_hub
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ideas_hub
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ideas_hub:changeme@db:5432/ideas_hub

# ---------- API ----------
API_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173

# ---------- LLM / Agentes ----------
NINEROUTER_BASE_URL=http://9router:20128
NINEROUTER_API_KEY=
LLM_FAST_MODEL=neovids-fast
LLM_STANDARD_MODEL=neovids-standard
LLM_STRONG_MODEL=neovids-strong
LLM_VISION_MODEL=neovids-vision
TAVILY_API_KEY=

# ---------- Embeddings ----------
# Modelo usado para gerar o vector(1024) salvo em ideias.embedding
EMBEDDING_PROVIDER=ninerouter
EMBEDDING_MODEL=neovids-embedding
EMBEDDING_DIM=1024

# ---------- Parâmetros ajustáveis (testar valores ideais) ----------
IDEIA_SIMILARITY_THRESHOLD=0.85
IDEIAS_POR_TREND=3
TRENDS_MAX_POR_FONTE=15

# ---------- Fontes de trend gratuitas ----------
YOUTUBE_API_KEY=
REDDIT_PUBLIC_USER_AGENT=ideas-hub/0.1 (uso pessoal)

# ---------- Media Indexer (audiovisual memory service) ----------
MEDIA_INDEXER_BASE_URL=http://localhost:8012
ORCHESTRATOR_BASE_URL=http://localhost:8011
MEDIA_INDEXER_TIMEOUT_SECONDS=30
MEDIA_INDEXER_API_KEY=
GAME_ANALYSIS_MEDIA_CONTEXT_MAX_CHARS=50000
